<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
      <groupId>io.github.emilevictor.neoproj4j</groupId>
      <artifactId>neoproj4j-modules</artifactId>
      <version>1.3.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.emilevictor.neoproj4j</groupId>
    <artifactId>neoproj4j-epsg</artifactId>
    <packaging>jar</packaging>
    <name>neoProj4J EPSG</name>
    <description>EPSG, ESRI, world, NAD83 and NAD27 init dictionaries for neoProj4J, plus PROJ's
        `conus` CTABLE V2 grid.</description>

    <!-- `conus` is deliberately duplicated, and this is a record of that decision, not a re-opening
         of it.

         The same grid ships twice in this repository:

           epsg/src/main/resources/proj4/nad/conus
           grids-us-legacy/src/main/resources/proj4j-data/grids/conus

         The two files are byte-identical. Verified with `cmp`, which exits 0 and prints nothing;
         both are 264,424 bytes; both are SHA-256
         504d184f9a9f6e6c6b76df753346fd236b74772f52a8a5c90d8a43d3651d274d. Both are PROJ 9.8.1 blob
         44b4900f3168a5b87794f41d201d03d5aea0b964, redistributed verbatim.

         The duplication is on purpose: each artifact is self-contained, so neither module depends
         on the other. `neoproj4j` plus `neoproj4j-epsg` covers the conterminous United States with
         no opt-in artifact; `neoproj4j-grids-us-legacy` stays usable on its own and its reason to
         exist is `alaska`. The resource paths differ on purpose too, so the two jars never collide
         on a classpath. Do not "fix" the duplication by making one module read the other's copy.
         See grids-us-legacy/README.md for the same note from the other side. -->

    <!-- Repeated rather than inherited: Maven appends this module's artifactId to an inherited
         <url> and <scm>. See the long note in the root POM; keep the values in step with it. -->
    <url>https://github.com/emilevictor/neoProj4J</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
        <license>
            <name>EPSG database distribution license</name>
            <url>https://raw.githubusercontent.com/emilevictor/neoProj4J/develop/LICENSE.EPSG</url>
        </license>
        <!-- Covers proj4/nad/conus, redistributed verbatim from PROJ 9.8.1 data/tests/conus
             (blob 44b4900f3168a5b87794f41d201d03d5aea0b964). PROJ's COPYING places data files
             under the same MIT terms as its source. -->
        <license>
            <name>MIT License (PROJ)</name>
            <url>https://raw.githubusercontent.com/emilevictor/neoProj4J/develop/LICENSE.PROJ</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/emilevictor/neoProj4J</url>
        <connection>scm:git:https://github.com/emilevictor/neoProj4J.git</connection>
        <developerConnection>scm:git:git@github.com:emilevictor/neoProj4J.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Published. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <build>
        <plugins>
            <!-- Both notices travel with the artifact rather than only being referenced from it: a
                 consumer who has the jar and nothing else still has the terms.

                 LICENSE.PROJ - MIT requires the notice to accompany the file, and this jar carries
                 PROJ's `conus` grid.

                 LICENSE.EPSG - this jar ships EPSG-derived data, and the EPSG Terms of Use clause
                 6.1 obliges the redistributor to "inform anyone to whom you provide the EPSG
                 Facilities of these Terms of Use". A URL in the POM does not inform a consumer who
                 has only the jar. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>embed-licenses</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>LICENSE.PROJ</include>
                                        <include>LICENSE.EPSG</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- There are no Java sources here, and maven-javadoc-plugin produces nothing at all for
                 a module without them - not an empty jar, no artifact. So 2.1.0 and 2.2.0 both went
                 to Central with a sources jar and no javadoc jar, which Central asks for next to
                 every published artifact. This attaches one by hand: src/javadoc holds a single page
                 saying the artifact carries data files and pointing at core's javadoc, and the jar
                 plugin publishes that directory under the -javadoc classifier. gpg and the
                 central-publishing plugin pick up attached artifacts on their own, so nothing else
                 needs to change. grids-us-legacy has the same gap and the same fix.

                 Two traps. The root .gitignore's bare `index.html` pattern matches at any depth and
                 swallowed src/javadoc/index.html on the first attempt, which would have published
                 an empty javadoc jar - the exact defect this fixes; both stub pages are un-ignored
                 by name there. And if a Java source file is ever added to this module, delete this
                 execution: the javadoc plugin would then attach a real jar under the same
                 classifier and the two would fight over it. -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadoc-stub</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/javadoc</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.locationtech.proj4j.epsg</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
