<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.emilevictor.neoproj4j</groupId>
        <artifactId>neoproj4j-modules</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.emilevictor.neoproj4j</groupId>
    <artifactId>neoproj4j-db</artifactId>
    <packaging>jar</packaging>
    <name>neoProj4J authority database</name>
    <description>
        PROJ 9.8.1's authority database (EPSG v12.029, ESRI ArcGIS Pro 3.6, IGNF 3.1.0, IAU_2015,
        NKG 1.0.w, NRCAN), transcoded at build time into a deterministic read-only binary index and
        served through a pure-Java reader. Implements org.locationtech.proj4j.spi.ProjDatabase.

        No SQLite, no JDBC, no native library, no network, no environment variables: the only
        dependency is neoProj4J itself. A raw proj.db in a jar cannot be opened without a native driver
        and an extraction to a filesystem we do not control, and a consumer whose reason for adopting
        this API is to delete Apache SIS would be worse off with a native dependency than without one.
    </description>

    <!-- Repeated rather than inherited: Maven appends this module's artifactId to an inherited
         <url> and <scm>. See the long note in the root POM; keep the values in step with it. -->
    <url>https://github.com/emilevictor/neoProj4J</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/emilevictor/neoProj4J</url>
        <connection>scm:git:https://github.com/emilevictor/neoProj4J.git</connection>
        <developerConnection>scm:git:git@github.com:emilevictor/neoProj4J.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Published, unlike conformance/golden/benchmark.
             `maven.package.skip` used to be set false here; it was inert and has been removed. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <maven.install.skip>false</maven.install.skip>

        <!-- release 8, same as core. This module DOES ship to consumers (it carries the reader as
             well as the data), so it inherits core's Java 8 floor. The generator under
             org/locationtech/proj4j/db/gen/ is build-time only and is excluded from the jar, but it
             is held to the same level so a contributor cannot accidentally make the shipped reader
             depend on a newer API through a shared helper. -->

        <!-- Upstream pins. proj.db is not checked into PROJ: it is generated by sqlite3 from the 52
             files listed in data/sql_filelist.cmake. -->
        <proj.rev>9.8.1</proj.rev>
        <proj.rev.sha>f08fa86c478c4bbbf003b1ec751dd84aa6eca486</proj.rev.sha>

        <!-- SHA-256 of the checked-in generated index. `mvn install` verifies this and FAILS on
             mismatch; it never regenerates. That is the mandated degradation path: a machine with no
             sqlite3, no cmake, no Python and no PROJ checkout builds successfully and cannot
             silently use a stale or hand-edited artifact. -->
        <proj4j.db.sha256>eb822e439c000ba0c62fd4818d5c32940b497cf87a7c438833b46946b9de1321</proj4j.db.sha256>

        <!-- Packaged-jar ceiling. A data bump that blows the budget must fail the build here rather
             than surprise a downstream Spark image. -->
        <proj4j.db.max.jar.bytes>2600000</proj4j.db.max.jar.bytes>

        <!-- Where -Pregen-db looks for a built proj.db. This default is only a convenience: it is
             where Homebrew on Apple silicon puts the file. Anywhere else (a Linux package, a
             source build of PROJ, an Intel Mac), pass the real path with
             -Dproj.db.source=/path/to/proj.db. Nothing in a default build reads this property. -->
        <proj.db.source>/opt/homebrew/share/proj/proj.db</proj.db.source>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Keep javadoc's view of this module in step with the jar's.
                 The jar below excludes org/locationtech/proj4j/db/gen/**, and the manifest below
                 declares an Automatic-Module-Name. Together those two put javadoc into MODULE mode
                 (a module-path holding this very jar, plus a patch-module for the source dirs),
                 where the module's package set is read from the BUILT JAR - which, by design, has
                 no `gen` package in it. javadoc was still handed `org.locationtech.proj4j.db.gen`
                 in its generated `packages` file, so it failed with
                 `error: No source files for package org.locationtech.proj4j.db.gen`.
                 Either setting alone is fine; it needs both, which is why this only appeared once
                 the reactor first reached this module.

                 Excluding the generator here rather than dropping either setting keeps both intents:
                 the module keeps its JPMS identity, and the build-time-only generator stays out of
                 BOTH the consumer's classpath and the published API docs - where it has exactly as
                 little business. Same pattern as geoapi/pom.xml, which excludes ...geoapi.spi. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <excludePackageNames>org.locationtech.proj4j.db.gen</excludePackageNames>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- The generator is build-time only. It is held in src/main so that the
                             format's writer and its reader sit next to each other and cannot drift,
                             but it has no business in a consumer's classpath. -->
                        <exclude>org/locationtech/proj4j/db/gen/**</exclude>
                    </excludes>
                    <archive>
                        <manifestEntries>
                            <!-- The data lives under /proj4j-data/db/, deliberately hyphenated: the
                                 path is not a valid Java package name, so JPMS treats it as
                                 unconditionally open rather than encapsulating it. -->
                            <Automatic-Module-Name>org.locationtech.proj4j.db</Automatic-Module-Name>
                            <Bundle-SymbolicName>org.locationtech.proj4j.db</Bundle-SymbolicName>
                            <Proj-Source-Rev>${proj.rev}</Proj-Source-Rev>
                            <Proj-Source-Commit>${proj.rev.sha}</Proj-Source-Commit>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <!-- The checked-in index must be exactly the bytes that were generated. This runs
                         in every default build, on every machine, with no toolchain required. -->
                    <execution>
                        <id>verify-checked-in-index</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFileChecksum>
                                    <file>${project.basedir}/src/main/resources/proj4j-data/db/proj4j-db.pjdx</file>
                                    <checksum>${proj4j.db.sha256}</checksum>
                                    <type>sha256</type>
                                    <message>
                                        The checked-in proj4j-db index does not match
                                        ${proj4j.db.sha256}. Either the file was edited by hand, or a
                                        regeneration changed it without the pin being updated. Run
                                        `mvn -Pregen-db -pl db -am process-classes` to regenerate and
                                        print the new SHA-256; do not relax this rule.
                                    </message>
                                </requireFileChecksum>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>db-size-budget</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesSize>
                                    <maxsize>${proj4j.db.max.jar.bytes}</maxsize>
                                    <files>
                                        <file>${project.build.directory}/${project.build.finalName}.jar</file>
                                    </files>
                                </requireFilesSize>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Regeneration. Manual only. Never part of a default build: `mvn install` must not need
             sqlite3, cmake, Python, a PROJ checkout or a network.

             The reproducibility proof is: regenerate, then `git diff` with the exit-code flag. If
             regeneration does not reproduce the checked-in bytes the diff is non-empty. That is why
             every ordering in the format is a total order over the data.

             Two details decide whether that proof measures anything, and both were got wrong here
             once, so they are spelled out:

               * PHASE. All three executions below bind to `generate-resources`, which `validate`
                 runs BEFORE. `mvn -Pregen-db validate` is therefore BUILD SUCCESS in half a second
                 having executed nothing, after which `git diff` passes because nothing was written,
                 reporting "reproducible" precisely when no regeneration happened. Nor can you
                 name `generate-resources` as the target phase: core is never installed (the root
                 POM sets maven.install.skip), so with -am the reactor has no core jar to resolve
                 against at that point and dependency resolution fails. `process-classes` is the
                 first phase that both fires these executions and resolves. `install` also works and
                 additionally runs the tests.

               * SOURCE_DATE_EPOCH. GenerateIndex stamps `generatedAtUtc` into db.properties from
                 it. Without it the stamp is the wall clock, so `git diff` is non-empty on every
                 run, reporting "not reproducible" for a regeneration that was bit-perfect. The
                 pinned value below is the one that reproduces the checked-in file.

             The invocation that actually proves something, verified to exit 0:

               SOURCE_DATE_EPOCH=1775865600 \
                 mvn -Pregen-db -pl db -am process-classes -Dproj.db.source=/path/to/proj.db

             followed by `git diff`, which must report no change. Run it with git's exit-code flag
             to make that scriptable; db/README.md spells the flag out, because an XML comment
             cannot contain two consecutive hyphens.

             NO WORKFLOW IN .github/ RUNS THIS, AND NONE WILL. Decided 2026-08-13, task #102. An
             earlier version of this comment claimed CI ran it, which was never true; this records
             why it is not going to become true either.

               * A gate would need sqlite3 AND a PROJ 9.8.1 proj.db. That file is not checked into
                 PROJ; it is built by sqlite3 from the 52 SQL files in data/sql_filelist.cmake, and
                 Ubuntu's proj-bin does not ship it at 9.8.1. Getting one means a cmake source build
                 of PROJ on the runner, which is precisely the toolchain the promise a few lines up
                 says a default build will never need.

               * What is already covered, with no toolchain and on every CI build, is the
                 requireFileChecksum execution above, bound to validate. It catches a hand-edited or
                 stale checked-in artifact, which is the risk that reaches consumers.

               * What stays uncovered is exactly one thing: "regeneration no longer reproduces these
                 bytes". That surfaces the next time a contributor regenerates, as a non-empty diff
                 from the verified invocation above. Accepting that gap is the decision, not an
                 oversight. db/README.md carries the full reasoning.

             (git's exit-code flag for the diff is spelled out in db/README.md rather than here,
             because an XML comment cannot contain two consecutive hyphens.) -->
        <profile>
            <id>regen-db</id>
            <build>
                <plugins>
                    <!-- Skip the checksum gate while regenerating, or the old pin would fail the
                         build before the new bytes exist. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-checked-in-index</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <!-- 1. Preflight and dump. Fails immediately, with a message pointing at
                                    omitting the profile, if sqlite3 is absent. Never falls back
                                    silently to the checked-in artifact. -->
                            <execution>
                                <id>dump-proj-db</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/src/gen/dump.sh</executable>
                                    <arguments>
                                        <argument>${proj.db.source}</argument>
                                        <argument>${project.build.directory}/proj-db-dump.quote</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 2. Transcode. Pure Java, no dependencies, deterministic. Rewrites the
                                    checked-in index and db.properties, and prints the new SHA-256 to
                                    paste into proj4j.db.sha256. -->
                            <execution>
                                <id>transcode</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.locationtech.proj4j.db.gen.GenerateIndex</mainClass>
                                    <arguments>
                                        <argument>${project.build.directory}/proj-db-dump.quote</argument>
                                        <argument>${project.basedir}/src/main/resources/proj4j-data/db</argument>
                                        <argument>${proj.rev}</argument>
                                        <argument>${proj.rev.sha}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 3. Exhaustive round-trip proof: every row of every transcoded table,
                                    compared field by field against the SQLite dump, with doubles
                                    compared bit-exactly. Fails the build on any mismatch. A size
                                    measurement and a handful of spot checks cannot catch a field read
                                    in the wrong order; this can. -->
                            <execution>
                                <id>verify-round-trip</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.locationtech.proj4j.db.gen.VerifyIndex</mainClass>
                                    <arguments>
                                        <argument>${project.build.directory}/proj-db-dump.quote</argument>
                                        <argument>${project.basedir}/src/main/resources/proj4j-data/db</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
