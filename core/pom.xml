<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
      <groupId>io.github.emilevictor.neoproj4j</groupId>
      <artifactId>neoproj4j-modules</artifactId>
      <version>1.3.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.emilevictor.neoproj4j</groupId>
    <artifactId>neoproj4j</artifactId>
    <packaging>bundle</packaging>
    <name>neoProj4J</name>
    <description>neoProj4J - a fork of LocationTech Proj4J brought to PROJ 9.8.1 parity. Java port of
        the PROJ library for coordinate reprojection.</description>

    <!-- Repeated rather than inherited: Maven appends this module's artifactId to an inherited
         <url> and <scm>. See the long note in the root POM; keep the values in step with it. -->
    <url>https://github.com/emilevictor/neoProj4J</url>
    <scm>
        <url>https://github.com/emilevictor/neoProj4J</url>
        <connection>scm:git:https://github.com/emilevictor/neoProj4J.git</connection>
        <developerConnection>scm:git:git@github.com:emilevictor/neoProj4J.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Published. -->
        <maven.deploy.skip>false</maven.deploy.skip>

        <!-- DELIBERATELY NOT RENAMED, here and in Automatic-Module-Name below. The Java packages
             stay org.locationtech.proj4j, so the OSGi and JPMS module names must match them: this
             artifact is a drop-in SUBSTITUTE for org.locationtech.proj4j:proj4j, not something that
             coexists with it. Consumers' `requires` clauses and OSGi Import-Package wiring keep
             working; only the Maven coordinate moved. -->
        <bundle-symbolicname>org.locationtech.proj4j</bundle-symbolicname>
        <maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
        <osgi-version-qualifier>${maven.build.timestamp}</osgi-version-qualifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j-epsg</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.8</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- see http://felix.apache.org/documentation/subprojects/apache-felix-maven-bundle-plugin-bnd.html -->
                    <instructions>
                        <!-- no 'uses' osgi directive -->
                        <_nouses>true</_nouses>
                        <_snapshot>${osgi-version-qualifier}</_snapshot>
                        <Bundle-SymbolicName>${bundle-symbolicname}</Bundle-SymbolicName>
                        <Automatic-Module-Name>org.locationtech.proj4j</Automatic-Module-Name>
                        <Import-Package />
                    </instructions>
                    <niceManifest>true</niceManifest>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Regeneration of EsriDatumTable.java from PROJ's own ESRI alias table. Manual only:
             `mvn install` compiles the checked-in file and needs no PROJ checkout and no network.

             The invocation, verified to exit 0, and to be re-run followed by a `git diff` that must
             report no change (git's exit-code flag is spelled in core/src/gen/esri-datum-table.sh,
             because an XML comment cannot contain two consecutive hyphens):

               mvn -Pregen-esri-datums -pl core generate-sources -Dproj.checkout=/path/to/PROJ

             `generate-sources` is both the phase the execution binds to and the phase named on the
             command line, so it fires. Naming an earlier phase would be BUILD SUCCESS having run
             nothing, after which a clean `git diff` would report "reproducible" for a regeneration
             that never happened. That mistake was made once in db/pom.xml and is recorded there.

             There is no checksum gate on this artifact and no CI leg that regenerates it, unlike
             db/. It does not need one: EsriDatumTableTest re-derives every row from
             `git show 9.8.1:data/sql/esri.sql` whenever a PROJ checkout is reachable, and skips
             loudly, naming the property to set, when one is not. That covers the stale-or-edited
             risk on any developer machine with a checkout, which is where regeneration happens. -->
        <profile>
            <id>regen-esri-datums</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>gen-esri-datum-table</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/src/gen/esri-datum-table.sh</executable>
                                    <arguments>
                                        <argument>${proj.checkout}</argument>
                                        <argument>${project.basedir}/src/main/java/org/locationtech/proj4j/io/wkt/EsriDatumTable.java</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
