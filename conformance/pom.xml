<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.emilevictor.neoproj4j</groupId>
        <artifactId>neoproj4j-modules</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>neoproj4j-conformance</artifactId>
    <packaging>jar</packaging>
    <name>neoProj4J PROJ Conformance Suite</name>
    <description>
        Runs PROJ's own gie and GIGS conformance corpora, vendored from PROJ 9.8.1, against neoProj4J.

        This module is NOT PUBLISHED. It exists only to produce a conformance number and to gate
        regressions. The vendored corpus carries third-party licence obligations - see
        src/test/resources/NOTICE-gie.md, which is a licence requirement and not documentation.

        The corpus is re-synced by conformance/sync-upstream.sh, which is pinned to a single PROJ rev.
    </description>

    <properties>
        <!-- Never published: this module vendors third-party test data and produces no artifact
             anyone should depend on.

             maven.deploy.skip stops maven-deploy-plugin. It does NOT stop
             central-publishing-maven-plugin, which the `central` profile installs as a build
             extension, so that plugin's publish goal is injected into every module in the reactor.
             This module attaches no artifact - packaging is jar, there is no src/main, and
             maven-jar-plugin below is set skipIfEmpty - so the injected goal has no file to stage and
             fails the build with "The packaging for this project did not assign a file to the build
             artifact".

             Release therefore runs `mvn -Pcentral deploy -DskipTests -pl '!conformance'`.

             Setting skipPublishing on this module looks like the tidier fix, and plugin 0.9.0 did
             make that flag per-module. It is NOT used here: the plugin performs the actual bundle
             upload at the LAST module in the reactor, and this module is last, so suppressing
             publishing here risks suppressing the upload for the whole build - a green log with
             nothing published. The -pl exclusion is the proven route. See HOWTORELEASE.txt. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>

        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <junit.platform.version>1.10.2</junit.platform.version>

        <!-- The heavy conformance run is opt-in. A plain `mvn install` compiles this module and runs
             only its fast unit tests (the lexer, the manifest, the comparator plumbing); the corpus
             sweep is bound to the `conformance` profile. -->
        <gie.corpus.skip>true</gie.corpus.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j-epsg</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The operation database. Test scope, because the corpus is the only thing here that
             needs it and core must keep working without it.

             This is not a convenience. 33 assertions in gie/nkg.gie name their operation as an OGC
             URN (urn:ogc:def:coordinateOperation:NKG::ITRF2000_TO_DK and 25 siblings) and nothing
             else - there is no proj-string form of those rows to fall back on. Upstream's `gie`
             resolves them through proj.db inside proj_create(); the only way to evaluate them at all
             is to have the database on the classpath. Without this dependency those 33 rows are not
             failures with a diagnosis, they are 33 rows the runner cannot even attempt, and they sit
             in the manifest as "proj4j has no operation database" forever.

             It is a ServiceLoader provider (org.locationtech.proj4j.spi.ProjDatabaseProvider), so
             adding the jar is the whole wiring; no conformance code names it. -->
        <dependency>
            <groupId>io.github.emilevictor.neoproj4j</groupId>
            <artifactId>neoproj4j-db</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5. The conformance runner needs @TestFactory: 7923 assertions cannot be modelled
             as static @Test methods, and JUnit 4's Parameterized gives useless failure names.
             junit-vintage is NOT needed here - this module has no JUnit 4 tests. core/ keeps
             JUnit 4 untouched. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No main sources; everything lives in src/test. Skip the main compile so an empty
                 src/main/java is not required. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Hermeticity, mirroring 9.8.1:cmake/ProjTest.cmake's proj_test_set_properties:
                         the corpus run must not be influenced by any grid or config outside this
                         module. proj4j core reads no environment variables, but the runner resolves
                         vendored resources relative to these. -->
                    <environmentVariables>
                        <PROJ_SKIP_READ_USER_WRITABLE_DIRECTORY>YES</PROJ_SKIP_READ_USER_WRITABLE_DIRECTORY>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <gie.corpus.skip>${gie.corpus.skip}</gie.corpus.skip>
                    </systemPropertyVariables>
                    <!-- The locale, timezone and charset pin that used to sit here has moved to the
                         root POM's surefire configuration, so it now covers every module rather than
                         only this one and golden. Nothing is lost: a surefire <configuration> that
                         omits argLine inherits the managed one.

                         Two things the version here got wrong, recorded rather than deleted because
                         they are the kind of mistake that gets a pin removed by whoever checks it:

                           - It blamed `Proj4FileReader.java:41 calls toLowerCase() with no Locale`.
                             That call is at :76 and reads toLowerCase(Locale.ROOT), already guarded
                             when the comment was written. The hazard it describes is real and the
                             count of 2,954 ESRI codes is right; the line it names is not the site.
                             golden/pom.xml carries the full correction and the three sites that ARE
                             still unguarded.
                           - It cited reference/performance.md, which has never existed in this
                             repository.

                         It also discarded any coverage agent, because a literal argLine with no
                         @{argLine} in it replaces the property surefire would otherwise expand. -->

                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn -Pconformance verify
                 Runs the full 7923-assertion corpus sweep and diffs it against the checked-in
                 expected-outcome manifest.

                 mvn -Pconformance verify -Dgie.regenerate=true
                 Rewrites the manifest from the observed run, preserving existing reason text. -->
            <id>conformance</id>
            <properties>
                <gie.corpus.skip>false</gie.corpus.skip>
            </properties>
        </profile>
    </profiles>
</project>
